# Environment Variables Configuration Example (Zero-Trust Template)
# DO NOT COMMIT ACTUAL PASSWORDS OR KEYS TO GIT REPOSITORIES

# Application Settings
FLASK_ENV=production
SECRET_KEY=generate-a-strong-random-secret-key-here
PORT=5000

# Database Credentials
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=devops_user
MYSQL_PASSWORD=SuperSecretSecurePassword123!
MYSQL_DB=devops_db
MYSQL_ROOT_PASSWORD=RootSuperSecretPassword456!

# Redis Cache Settings
USE_REDIS=false
REDIS_HOST=redis
REDIS_PORT=6379

# AWS Secrets Manager Integration (Optional for Cloud Deployments)
# AWS_SECRET_NAME=prod/devsecops/credentials
# AWS_DEFAULT_REGION=us-east-1
